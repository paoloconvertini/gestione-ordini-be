# Copy this file to .env.local and fill local values.
# .env.local is ignored by Git.

# Common
CORS_ORIGIN=*
LOG_LEVEL=DEBUG
LOG_DIR=/Users/pconvertini/IdeaProjects/logs/gestione-ordini/api.log
DATA_INIZIO=2023-03-15
STORICO=false

# Authentication service
AUTH_DB_USER=root
AUTH_DB_PASSWORD=root
AUTH_URL=jdbc:mysql://localhost:3306/auth
CRYPTO_KEY=change-me-16-chars

# Main API database
DB_USER=sa
DB_PASSWORD=change-me
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=master;encrypt=true;trustServerCertificate=true;
DB_URL_COMMON=jdbc:sqlserver://localhost:1433;databaseName=legacy;encrypt=true;trustServerCertificate=true;

# Ostuni API database
DB_O_USER=sa
DB_O_PASSWORD=change-me
DB_O_URL=jdbc:sqlserver://localhost:1434;database=master;encrypt=true;trustServerCertificate=true;

# Ceglie API database
DB_C_USER=sa
DB_C_PASSWORD=change-me
DB_C_URL=jdbc:sqlserver://localhost:1435;database=master;encrypt=true;trustServerCertificate=true;

# Filesystem paths
FIRMA_ORDINI_PATH=/Users/pconvertini/Documents/firme_ordini_clienti/
FIRMA_VENDITORE_PATH=/Users/pconvertini/Documents/firma_venditori/
ORDINI_PATH=/Users/pconvertini/Documents/ordini/
TEMP_FOLDER=/Users/pconvertini/Documents/tmp/
LISTA_CARICO_PATH=/Users/pconvertini/Documents/lista_carico

# Auth REST client
MP_REST_URL=http://localhost:8081

# Mail
MAIL_FROM=change-me@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
ADMIN_EMAIL=change-me@example.com

# Dropbox
DBX_APP_KEY=change-me
DBX_SECRET=change-me
DBX_REFRESH_TOKEN=change-me
DBX_AUTH_URL=https://api.dropboxapi.com/oauth2/token

# Scheduler expressions

# Microsoft calendar
TENANT_ID=change-me
CLIENT_ID=change-me
CLIENT_SECRET=change-me
USER_MAIL=change-me@example.com
CALENDAR_ID=change-me
# CRON_EXPR* values are defined in application.properties for dev profile.
